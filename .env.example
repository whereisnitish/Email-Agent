# Email -> Customer Intent Extraction
# Copy to .env and fill in ONE key. All of these have a free tier.
# With no key set, the deterministic rule engine runs offline.

# Groq - free, fast, JSON mode. https://console.groq.com  (recommended default)
GROQ_API_KEY=

# Google Gemini - free tier. https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter - free models carry a ":free" suffix. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Ollama - fully local, no account needed. Start it with: ollama serve
# OLLAMA_HOST=http://localhost:11434

# Optional overrides
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
